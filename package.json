{
  "name": "dark-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx --env-file=.env src/cli.ts",
    "factory": "node --env-file=.env dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.2.0",
    "fast-xml-parser": "^5.11.2",
    "openai": "^7.38.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
